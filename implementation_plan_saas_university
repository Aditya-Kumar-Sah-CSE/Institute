### 8.2 Stripe Webhook Handler

```typescript
// app/api/webhooks/stripe/route.ts
import Stripe from 'stripe';

export async function POST(req: Request) {
  const body = await req.text();
  const sig = req.headers.get('stripe-signature')!;
  const event = stripe.webhooks.constructEvent(body, sig, process.env.STRIPE_WEBHOOK_SECRET!);

  switch (event.type) {
    case 'customer.subscription.created':
      // Activate tenant, set billing_status = 'active'
      await activateTenant(event.data.object.metadata.tenant_id);
      break;

    case 'invoice.payment_succeeded':
      // Record payment, extend current_period_end
      await recordPayment(event.data.object);
      break;

    case 'invoice.payment_failed':
      // Set billing_status = 'past_due', send warning email
      await handlePaymentFailure(event.data.object);
      break;

    case 'customer.subscription.deleted':
      // Set billing_status = 'suspended', block access via middleware
      await suspendTenant(event.data.object.metadata.tenant_id);
      break;
  }

  return new Response('OK', { status: 200 });
}
```

### 8.3 Billing Lifecycle

```
Institute Signs Up → 14-day Free Trial
     ↓
Trial Ends → Stripe charges card
     ↓
Payment Success → billing_status = 'active'
     ↓
Monthly Auto-renewal via Stripe
     ↓
Payment Fails → billing_status = 'past_due' → 3 retry attempts
     ↓
All Retries Fail → billing_status = 'suspended'
