### 6.2 Core: Tenant Resolver Middleware

```typescript
// src/middleware.ts — THE MOST CRITICAL FILE
import { NextRequest, NextResponse } from 'next/server';
import { getTenantBySlug } from '@/lib/tenant/resolver';

export async function middleware(request: NextRequest) {
  const hostname = request.headers.get('host') || '';
  const pathname = request.nextUrl.pathname;

  // --- Strategy 1: Subdomain-based routing ---
  // bce.edusaas.com → tenant = 'bce'
  const subdomain = hostname.split('.')[0];
  const isSubdomainTenant = !['www', 'admin', 'api', 'edusaas'].includes(subdomain);

  // --- Strategy 2: Path-based routing (fallback) ---
  // edusaas.com/bce/dashboard → tenant = 'bce'
  const pathTenant = pathname.split('/')[1];

  const tenantSlug = isSubdomainTenant ? subdomain : pathTenant;

  // Skip for super-admin, marketing pages, API, and static assets
  if (['admin', 'api', '_next', 'favicon.ico'].includes(tenantSlug)) {
    return NextResponse.next();
  }

  // Resolve tenant from Redis cache or Master DB
  const tenant = await getTenantBySlug(tenantSlug);

  if (!tenant) {
    return NextResponse.redirect(new URL('/not-found', request.url));
  }

  // Check billing status — block suspended tenants
  if (tenant.billing_status === 'suspended') {
    return NextResponse.redirect(new URL('/suspended', request.url));
  }

  // Inject tenant info into request headers for downstream use
  const response = NextResponse.next();
  response.headers.set('x-tenant-id', tenant.id);
  response.headers.set('x-tenant-schema', tenant.schema_name);
  response.headers.set('x-tenant-slug', tenant.slug);

  return response;
}

export const config = {
  matcher: ['/((?!_next/static|_next/image|favicon.ico).*)'],
};
```

### 6.3 Dynamic DB Connection Per Tenant

```typescript
// lib/db/tenant.ts
import { drizzle } from 'drizzle-orm/node-postgres';
import { Pool } from 'pg';
import { sql } from 'drizzle-orm';
import { headers } from 'next/headers';

// Shared connection pool (PgBouncer handles the rest)
const pool = new Pool({
  connectionString: process.env.DATABASE_URL,
  max: 20,  // max connections
});

export async function getTenantDb() {
  const headersList = await headers();
  const schemaName = headersList.get('x-tenant-schema');

  if (!schemaName) throw new Error('No tenant context found');

  const db = drizzle(pool);

  // Switch to tenant's schema
  await db.execute(sql`SET search_path TO ${sql.raw(schemaName)}`);

  return db;
}

// Usage in any Server Component or Server Action:
