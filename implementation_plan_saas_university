### 5.3 Tenant Provisioning Script (Automated)

```typescript
// lib/tenant-provisioning.ts
import { drizzle } from 'drizzle-orm/node-postgres';
import { sql } from 'drizzle-orm';
import { readFileSync } from 'fs';
import path from 'path';

export async function provisionNewTenant(
  slug: string,
  name: string,
  adminEmail: string
) {
  const schemaName = `tenant_${slug}`;
  const db = drizzle(process.env.DATABASE_URL!);

  // 1. Create the new schema
  await db.execute(sql`CREATE SCHEMA IF NOT EXISTS ${sql.raw(schemaName)}`);

  // 2. Set search path to new schema
  await db.execute(sql`SET search_path TO ${sql.raw(schemaName)}`);

  // 3. Run all 59 migration files in order
  const migrationDir = path.join(process.cwd(), 'migrations');
  const files = [
    '001_create_tables.sql',
    '002_rls_policies.sql',
    '003_seed_data.sql',
    // ... all 59 files (001 through 059)
  ];

  for (const file of files) {
    const sqlContent = readFileSync(path.join(migrationDir, file), 'utf-8');
    await db.execute(sql.raw(sqlContent));
  }

  // 4. Insert into master tenants table
  await db.execute(sql`SET search_path TO public`);
  await db.execute(sql`
    INSERT INTO tenants (name, slug, schema_name, admin_email)
    VALUES (${name}, ${slug}, ${schemaName}, ${adminEmail})
  `);

  // 5. Create admin profile in tenant schema
  await db.execute(sql`SET search_path TO ${sql.raw(schemaName)}`);
  await db.execute(sql`
    UPDATE profiles SET role = 'admin'
    WHERE email = ${adminEmail}
  `);

  return { schemaName, success: true };
}
```

